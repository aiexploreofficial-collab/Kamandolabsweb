// ============================================================================
// KOMANDO LABS — Production Database Schema
// Stack: PostgreSQL + Prisma ORM
// Convention: UUID PKs, strict enums, snake_case tables, timestamps everywhere
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR

  @@map("admin_role")
}

enum LoginStatus {
  SUCCESS
  FAILED
  BLOCKED

  @@map("login_status")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  RTO

  @@map("order_status")
}

enum PaymentMethod {
  COD

  @@map("payment_method")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("review_status")
}

enum CouponType {
  FLAT
  PERCENTAGE

  @@map("coupon_type")
}

enum VerificationStatus {
  VALID
  INVALID
  ALREADY_USED

  @@map("verification_status")
}

enum ShippingRuleType {
  FREE_ABOVE
  FLAT
  SLAB

  @@map("shipping_rule_type")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("blog_status")
}

enum MediaType {
  IMAGE
  VIDEO

  @@map("media_type")
}

enum BlacklistType {
  PHONE

  @@map("blacklist_type")
}

enum FraudRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("fraud_risk_level")
}

// ============================================================================
// ADMIN & AUTH
// ============================================================================

/// Admin user accounts — passwords stored as bcrypt hashes only
model Admin {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  loginLogs  AdminLoginLog[]
  blogs      Blog[]
  blacklists Blacklist[]
  fraudLogs  FraudLog[]      @relation("FraudResolver")

  @@map("admins")
}

/// Immutable log of every admin login attempt — never deleted
model AdminLoginLog {
  id        String      @id @default(uuid()) @db.Uuid
  adminId   String?     @map("admin_id") @db.Uuid
  email     String
  ipAddress String      @map("ip_address")
  userAgent String?     @map("user_agent")
  status    LoginStatus
  createdAt DateTime    @default(now()) @map("created_at")

  // Relations
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([email])
  @@index([createdAt])
  @@index([email, status, createdAt])
  @@map("admin_login_logs")
}

// ============================================================================
// CATALOG: CATEGORIES, PRODUCTS, VARIANTS
// ============================================================================

/// Product categories with self-referential hierarchy support
model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  image       String?
  parentId    String?  @map("parent_id") @db.Uuid
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@index([sortOrder])
  @@index([isActive, sortOrder])
  @@map("categories")
}

/// Shared media library — polymorphic via entityType + entityId
model Media {
  id         String    @id @default(uuid()) @db.Uuid
  url        String
  altText    String?   @map("alt_text")
  type       MediaType @default(IMAGE)
  fileName   String?   @map("file_name")
  fileSize   Int?      @map("file_size")
  mimeType   String?   @map("mime_type")
  width      Int?
  height     Int?
  entityType String?   @map("entity_type") // "product" | "review" | "blog" | "category" | "banner"
  entityId   String?   @map("entity_id") @db.Uuid
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([entityType, entityId])
  @@index([sortOrder])
  @@index([type])
  @@map("media")
}

/// Products with cached rating aggregates and SEO fields
model Product {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  slug             String        @unique
  description      String?       @db.Text
  shortDescription String?       @map("short_description")
  categoryId       String        @map("category_id") @db.Uuid
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false) @map("is_featured")
  gallery          Json?         // String[] — array of image URLs
  avgRating        Decimal       @default(0) @map("avg_rating") @db.Decimal(3, 2)
  totalReviews     Int           @default(0) @map("total_reviews")
  themeColor       String?       @map("theme_color") // "spartan-red" | "hard-blue" | null
  seoTitle         String?       @map("seo_title")
  seoDescription   String?       @map("seo_description") @db.Text
  seoKeywords      String?       @map("seo_keywords")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  category   Category         @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  reviews    Review[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([status])
  @@index([status, isFeatured])
  @@index([status, createdAt])
  @@index([slug])
  @@map("products")
}

/// Product variants — flavor/size combos with independent pricing and stock
/// Pricing: MRP (maximum retail price) and salePrice, discount auto-derived
model ProductVariant {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  name            String   // Display name, e.g. "Chocolate — 1kg"
  flavor          String?
  size            String?
  mrp             Decimal  @db.Decimal(10, 2)
  salePrice       Decimal  @map("sale_price") @db.Decimal(10, 2)
  discountPercent Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  stock           Int      @default(0)
  images          Json?    // String[] — variant-specific images
  isDefault       Boolean  @default(false) @map("is_default")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
  verificationCodes VerificationCode[]

  @@index([productId])
  @@index([productId, isActive])
  @@map("product_variants")
}

// ============================================================================
// REVIEWS
// ============================================================================

/// Product reviews — verified purchase only, manual admin moderation
model Review {
  id            String       @id @default(uuid()) @db.Uuid
  productId     String       @map("product_id") @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  orderItemId   String?      @map("order_item_id") @db.Uuid
  customerName  String       @map("customer_name")
  customerPhone String       @map("customer_phone")
  rating        Int          // 1–5 stars
  title         String?
  comment       String?      @db.Text
  photos        Json?        // String[] — review photo URLs
  status        ReviewStatus @default(PENDING)
  isFeatured    Boolean      @default(false) @map("is_featured")
  adminNotes    String?      @map("admin_notes") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  product Product @relation(fields: [productId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  @@index([productId, status])
  @@index([orderId])
  @@index([status])
  @@index([customerPhone])
  @@index([isFeatured, status])
  @@map("reviews")
}

// ============================================================================
// ORDERS
// ============================================================================

/// Guest checkout orders — full address + coupon snapshots frozen at order time
/// Order numbers: KMD-ORD-XXXXX (human-facing, auto-generated)
model Order {
  id              String        @id @default(uuid()) @db.Uuid
  orderNumber     String        @unique @map("order_number") // KMD-ORD-XXXXX
  customerName    String        @map("customer_name")
  customerEmail   String?       @map("customer_email")
  customerPhone   String        @map("customer_phone")
  shippingAddress Json          @map("shipping_address") // Full address snapshot (versioned JSON)
  couponCode      String?       @map("coupon_code")
  couponSnapshot  Json?         @map("coupon_snapshot") // Full coupon config at order time
  subtotal        Decimal       @db.Decimal(10, 2)
  shippingAmount  Decimal       @map("shipping_amount") @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(10, 2)
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(COD) @map("payment_method")
  fraudScore      Int           @default(0) @map("fraud_score") // 0–100
  fraudFlags      Json?         @map("fraud_flags") // String[] — fraud indicators
  notes           String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  reviews       Review[]
  couponUsages  CouponUsage[]
  fraudLogs     FraudLog[]

  @@index([customerPhone])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([customerEmail])
  @@map("orders")
}

/// Individual line items — price/name snapshots frozen at order time
model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  variantId   String  @map("variant_id") @db.Uuid
  productName String  @map("product_name") // Snapshot
  variantName String  @map("variant_name") // Snapshot
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice  Decimal @map("total_price") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

/// Immutable append-only log of every order status transition — never deleted
model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  changedBy  String?      @map("changed_by") @db.Uuid // Admin ID, null = system
  notes      String?      @db.Text
  createdAt  DateTime     @default(now()) @map("created_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_history")
}

// ============================================================================
// COUPONS
// ============================================================================

/// Coupon definitions — flat/percentage, min cart, max cap, product/category scoped
model Coupon {
  id           String     @id @default(uuid()) @db.Uuid
  code         String     @unique
  description  String?
  type         CouponType
  value        Decimal    @db.Decimal(10, 2) // Amount for FLAT, percentage for PERCENTAGE
  minCartValue Decimal?   @map("min_cart_value") @db.Decimal(10, 2)
  maxDiscount  Decimal?   @map("max_discount") @db.Decimal(10, 2) // Cap for PERCENTAGE type
  usageLimit   Int?       @map("usage_limit") // null = unlimited
  usedCount    Int        @default(0) @map("used_count")
  validFrom    DateTime   @map("valid_from")
  validUntil   DateTime   @map("valid_until")
  isActive     Boolean    @default(true) @map("is_active")
  productIds   Json?      @map("product_ids") // String[] UUIDs — null = all products
  categoryIds  Json?      @map("category_ids") // String[] UUIDs — null = all categories
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relations
  usages CouponUsage[]

  @@index([code])
  @@index([isActive, validFrom, validUntil])
  @@map("coupons")
}

/// Coupon usage tracking — enforces single-use per phone number
model CouponUsage {
  id              String   @id @default(uuid()) @db.Uuid
  couponId        String   @map("coupon_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  phone           String
  discountApplied Decimal  @map("discount_applied") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@unique([couponId, phone]) // Enforce single-use per phone
  @@index([phone])
  @@index([couponId])
  @@map("coupon_usages")
}

// ============================================================================
// SHIPPING
// ============================================================================

/// Rule-based shipping calculator — free above X, flat rate, or slab-based
model ShippingRule {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  type           ShippingRuleType
  minCartValue   Decimal?         @map("min_cart_value") @db.Decimal(10, 2)
  maxCartValue   Decimal?         @map("max_cart_value") @db.Decimal(10, 2)
  shippingCharge Decimal          @map("shipping_charge") @db.Decimal(10, 2)
  isActive       Boolean          @default(true) @map("is_active")
  priority       Int              @default(0) // Higher = checked first
  config         Json?            // Additional rule config (slab breakpoints, etc.)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([isActive, priority])
  @@map("shipping_rules")
}

// ============================================================================
// PRODUCT VERIFICATION (Scratch Codes)
// ============================================================================

/// Verification scratch codes — ONLY hash stored, never plaintext
/// Admin generates 1–2000 codes per batch, linked to product variant
model VerificationCode {
  id               String    @id @default(uuid()) @db.Uuid
  codeHash         String    @unique @map("code_hash") // SHA-256 hash of scratch code
  productVariantId String    @map("product_variant_id") @db.Uuid
  batch            String?   // Optional batch identifier
  isUsed           Boolean   @default(false) @map("is_used")
  verifiedAt       DateTime? @map("verified_at")
  verifiedPhone    String?   @map("verified_phone")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  productVariant ProductVariant           @relation(fields: [productVariantId], references: [id])
  attemptLogs    VerificationAttemptLog[]

  @@index([productVariantId])
  @@index([batch])
  @@index([isUsed])
  @@map("verification_codes")
}

/// Immutable log of every verification attempt — never deleted
model VerificationAttemptLog {
  id                 String             @id @default(uuid()) @db.Uuid
  codeInput          String             @map("code_input") // Raw input for logging
  verificationCodeId String?            @map("verification_code_id") @db.Uuid
  ipAddress          String             @map("ip_address")
  userAgent          String?            @map("user_agent")
  phone              String?
  status             VerificationStatus
  createdAt          DateTime           @default(now()) @map("created_at")

  // Relations
  verificationCode VerificationCode? @relation(fields: [verificationCodeId], references: [id], onDelete: SetNull)

  @@index([verificationCodeId])
  @@index([ipAddress])
  @@index([phone])
  @@index([createdAt])
  @@index([ipAddress, createdAt])
  @@map("verification_attempt_logs")
}

// ============================================================================
// SECURITY: BLACKLIST & FRAUD
// ============================================================================

/// Phone-number blacklist — prevents orders from flagged numbers
model Blacklist {
  id        String        @id @default(uuid()) @db.Uuid
  type      BlacklistType @default(PHONE)
  value     String        // The phone number
  reason    String?       @db.Text
  addedBy   String        @map("added_by") @db.Uuid // Admin who added
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  // Relations
  admin Admin @relation(fields: [addedBy], references: [id])

  @@unique([type, value])
  @@index([value])
  @@map("blacklists")
}

/// Fraud event log — detailed tracking with risk scoring and resolution
model FraudLog {
  id         String         @id @default(uuid()) @db.Uuid
  orderId    String?        @map("order_id") @db.Uuid
  phone      String?
  ipAddress  String?        @map("ip_address")
  riskLevel  FraudRiskLevel @map("risk_level")
  reason     String
  details    Json?          // Structured fraud evidence
  resolvedBy String?        @map("resolved_by") @db.Uuid
  resolvedAt DateTime?      @map("resolved_at")
  resolution String?        @db.Text
  createdAt  DateTime       @default(now()) @map("created_at")

  // Relations
  order    Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  resolver Admin? @relation("FraudResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([phone])
  @@index([riskLevel])
  @@index([createdAt])
  @@map("fraud_logs")
}

// ============================================================================
// BLOG / CONTENT
// ============================================================================

/// Blog posts with AI draft workflow and SEO fields
model Blog {
  id             String     @id @default(uuid()) @db.Uuid
  title          String
  slug           String     @unique
  content        String     @db.Text
  excerpt        String?    @db.Text
  coverImage     String?    @map("cover_image")
  status         BlogStatus @default(DRAFT)
  isAiGenerated  Boolean    @default(false) @map("is_ai_generated")
  aiPrompt       String?    @map("ai_prompt") @db.Text
  authorId       String     @map("author_id") @db.Uuid
  authorName     String     @map("author_name") // Snapshot
  tags           Json?      // String[] — tag strings
  readingTime    Int        @default(0) @map("reading_time") // Minutes
  seoTitle       String?    @map("seo_title")
  seoDescription String?    @map("seo_description") @db.Text
  publishedAt    DateTime?  @map("published_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  // Relations
  author Admin @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([status, publishedAt])
  @@index([authorId])
  @@index([slug])
  @@map("blogs")
}

// ============================================================================
// SETTINGS & ANALYTICS
// ============================================================================

/// Key-value store for dynamic site configuration
model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json     // Flexible JSON value
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// Flexible event tracking for analytics dashboard
model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  eventType  String   @map("event_type") // "page_view" | "add_to_cart" | "order_placed" | etc.
  entityType String?  @map("entity_type") // "product" | "order" | "blog" | etc.
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?    // Flexible event-specific data
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  sessionId  String?  @map("session_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventType])
  @@index([entityType, entityId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([eventType, createdAt])
  @@map("analytics_events")
}
